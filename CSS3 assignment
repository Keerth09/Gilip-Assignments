<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CSS3 – All Programs (1–62)</title>

<style>
/* ===== COMMON STYLES ===== */
section {
  border: 1px solid #ccc;
  padding: 15px;
  margin: 20px 0;
}
h2 { background:#f2f2f2; padding:10px; }

/* ===== GRID EXAMPLES ===== */
.grid3 { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.grid2 { display:grid; grid-template-columns:1fr 2fr; gap:10px; }
.grid-item { background:#f0f0f0; padding:20px; text-align:center; }

/* ===== FLEX ===== */
.flex { display:flex; gap:10px; }
.center-flex {
  display:flex; justify-content:center; align-items:center;
  height:200px; background:#ddd;
}

/* ===== POSITION ===== */
.relative { position:relative; height:200px; background:#eee; }
.absolute {
  position:absolute; bottom:10px; right:10px;
  background:tomato; color:white; padding:10px;
}

/* ===== Z INDEX ===== */
.box { width:100px; height:100px; position:absolute; }
.red { background:red; top:50px; left:50px; z-index:1; }
.blue { background:blue; top:80px; left:80px; z-index:2; }

/* ===== NAV ===== */
nav { display:flex; justify-content:space-around; background:#333; padding:10px; }
nav a { color:white; text-decoration:none; }

/* ===== GALLERY ===== */
.gallery {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(100px,1fr));
  gap:10px;
}
.gallery div { background:coral; padding:20px; text-align:center; }

/* ===== TOOLTIP ===== */
.tooltip { position:relative; display:inline-block; }
.tip {
  visibility:hidden;
  position:absolute;
  bottom:125%; left:50%;
  transform:translateX(-50%);
  background:black; color:white; padding:5px;
}
.tooltip:hover .tip { visibility:visible; }

/* ===== DROPDOWN ===== */
.dropdown { position:relative; display:inline-block; }
.dropdown-content {
  display:none; position:absolute;
  background:#f9f9f9; min-width:120px;
}
.dropdown:hover .dropdown-content { display:block; }

/* ===== MODAL ===== */
.modal {
  display:none; position:fixed; inset:0;
  background:rgba(0,0,0,0.5);
}
.modal-content {
  background:white; margin:15% auto;
  padding:20px; width:200px;
}
</style>
</head>

<body>

