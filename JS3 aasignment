<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>JavaScript Loop Programs</title>

<style>
body {
  font-family: Arial, sans-serif;
  background: #f4f6f9;
  padding: 20px;
}
h1 { color: #007acc; }
h2 { margin-top: 30px; }
.output {
  background: #eef;
  padding: 10px;
  border-radius: 5px;
  margin-bottom: 15px;
  font-family: monospace;
}
</style>
</head>

<body>

<h1>JavaScript Loop Programs (1–50)</h1>

<h2>Basic Loops</h2>

<div class="output">1. Numbers 1–5:
<script>
let r1="";
for(let i=1;i<=5;i++) r1+=i+" ";
document.write(r1);
</script>
</div>

<div class="output">2. Array Iteration:
<script>
let fruits=["Apple","Banana","Cherry"], r2="";
for(let i=0;i<fruits.length;i++) r2+=fruits[i]+" ";
document.write(r2);
</script>
</div>

<div class="output">3. for...of:
<script>
let colors=["Red","Green","Blue"], r3="";
for(let c of colors) r3+=c+" ";
document.write(r3);
</script>
</div>

<div class="output">4. for...in (Object):
<script>
let person={name:"John",age:30,city:"Indore"}, r4="";
for(let k in person) r4+=k+":"+person[k]+" | ";
document.write(r4);
</script>
</div>

<div class="output">5. while Loop:
<script>
let i5=1,r5="";
while(i5<=5){r5+=i5+" ";i5++;}
document.write(r5);
</script>
</div>

<div class="output">6. do...while Loop:
<script>
let i6=1,r6="";
do{r6+=i6+" ";i6++;}while(i6<=5);
document.write(r6);
</script>
</div>

<h2>Loop Control</h2>

<div class="output">7. Nested Loop (Table 1–3):
<script>
let r7="";
for(let i=1;i<=3;i++){
  for(let j=1;j<=3;j++){
    r7+=i+"x"+j+"="+(i*j)+" | ";
  }
}
document.write(r7);
</script>
</div>

<div class="output">8. break Example:
<script>
let r8="";
for(let i=1;i<=10;i++){
  if(i===5) break;
  r8+=i+" ";
}
document.write(r8);
</script>
</div>

<div class="output">9. continue Example:
<script>
let r9="";
for(let i=1;i<=10;i++){
  if(i%2===0) continue;
  r9+=i+" ";
}
document.write(r9);
</script>
</div>

<h2>Array Methods</h2>

<div class="output">10. forEach:
<script>
let nums=[1,2,3,4], r10="";
nums.forEach(n=>r10+=n+" ");
document.write(r10);
</script>
</div>

<div class="output">11. map:
<script>
document.write([1,2,3].map(n=>n*2));
</script>
</div>

<div class="output">12. filter:
<script>
document.write([1,2,3,4,5].filter(n=>n%2===0));
</script>
</div>

<div class="output">13. reduce (Sum):
<script>
document.write([1,2,3,4].reduce((a,b)=>a+b,0));
</script>
</div>

<h2>Logic Programs</h2>

<div class="output">14. Reverse Number:
<script>
let num=1234,rev=0;
while(num>0){rev=rev*10+num%10;num=Math.floor(num/10);}
document.write(rev);
</script>
</div>

<div class="output">15. Factorial:
<script>
let n=5,f=1;
for(let i=1;i<=n;i++) f*=i;
document.write(f);
</script>
</div>

<div class="output">16. Palindrome:
<script>
let x=121,tmp=x,rv=0;
while(x>0){rv=rv*10+x%10;x=Math.floor(x/10);}
document.write(tmp===rv?"Palindrome":"Not Palindrome");
</script>
</div>

<div class="output">17. Fibonacci:
<script>
let a=0,b=1;
for(let i=1;i<=6;i++){
  document.write(a+" ");
  let c=a+b;a=b;b=c;
}
</script>
</div>

<div class="output">18. Star Pattern:
<script>
for(let i=1;i<=5;i++) document.write("* ".repeat(i)+"<br>");
</script>
</div>

<h2>Advanced Loop Examples</h2>

<div class="output">19. Largest in Array:
<script>
let arr=[5,12,8,20],max=arr[0];
for(let i=1;i<arr.length;i++) if(arr[i]>max) max=arr[i];
document.write(max);
</script>
</div>

<div class="output">20. Count Vowels:
<script>
let s="javascript",cnt=0;
for(let ch of s) if("aeiou".includes(ch)) cnt++;
document.write(cnt);
</script>
</div>

<div class="output">21. Remove Duplicates:
<script>
let ar=[1,2,2,3,3],u=[];
for(let x of ar) if(!u.includes(x)) u.push(x);
document.write(u);
</script>
</div>

<div class="output">22. Even & Odd Count:
<script>
let ns=[1,2,3,4,5],e=0,o=0;
for(let n of ns) n%2===0?e++:o++;
document.write("Even:"+e+" Odd:"+o);
</script>
</div>

<div class="output">23. Reverse String:
<script>
let st="hello",rs="";
for(let i=st.length-1;i>=0;i--) rs+=st[i];
document.write(rs);
</script>
</div>

<div class="output">24. Countdown:
<script>
for(let i=10;i>=0;i--) document.write(i+" ");
</script>
</div>

<div class="output">25. Labelled Break:
<script>
let res="";
loop1:
for(let i=0;i<3;i++){
  for(let j=0;j<3;j++){
    if(i===1 && j===1) break loop1;
    res+="i:"+i+" j:"+j+" | ";
  }
}
document.write(res);
</script>
</div>

<div class="output">26. setTimeout with let:
<script>
for(let i=1;i<=3;i++){
  setTimeout(()=>document.write(i+" "),i*1000);
}
</script>
</div>

</body>
</html>
