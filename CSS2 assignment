<title>CSS2 – All Programs</title>

<style>

/* ===== TEXT PROPERTIES (1–7) ===== */
.p1 { color: blue; }
.p2 { text-align: center; }
.p3 { text-decoration: underline; }
.p4 { text-transform: uppercase; }
.p5 { letter-spacing: 5px; }
.p6 { word-spacing: 20px; }
.p7 { line-height: 2; }

/* ===== FONT STYLING (8–14) ===== */
.p8 { font-family: Arial; }
.p9 { font-size: 24px; }
.p10 { font-weight: bold; }
.p11 { font-family: 'Roboto', sans-serif; }
.p12 { font: italic bold 20px Georgia; }
.p13 { font-size: 2vw; }

/* ===== BOX MODEL (15–23) ===== */
.box15 { margin: 20px; background: lightblue; }
.box16 { padding: 20px; background: lightgreen; }
.box17 { border: 2px solid red; }
.box18 { border: 2px solid black; border-radius: 10px; }
.box19 { box-shadow: 5px 5px 10px gray; }
.box20 { width: 200px; height: 100px; background: pink; }
.box21 { width: 150px; height: 50px; overflow: scroll; border: 1px solid; }
.box22 { padding: 20px; background: beige; }
.box23 {
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid;
}

/* ===== CARDS & EFFECTS (24–33) ===== */
.h24 { background: yellow; padding: 10px; }
.card25 { border: 1px solid #ccc; padding: 15px; box-shadow: 2px 2px 8px #aaa; }
.p26 { border: 2px solid blue; border-radius: 15px; padding: 10px; }
.p27 { border: dashed 2px green; padding: 5px; }
.box28 { width: 200px; height: 100px; border: 1px solid; text-align: center; }
.p29 { background: linear-gradient(to right, red, yellow); padding: 10px; }
.box30 { background: rgba(0,0,255,0.3); padding: 20px; }
.p31 { text-shadow: 2px 2px 5px gray; }

.card32 {
  width: 300px;
  padding: 20px;
  margin: 40px auto;
  border-radius: 15px;
  box-shadow: 5px 5px 15px rgba(0,0,0,0.1);
  font-family: Arial;
}

.card32 h2 {
  text-align: center;
  text-transform: uppercase;
}

.card33 {
  width: 300px;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 0 10px gray;
}

/* ===== NAVBARS & LAYOUTS (35–46) ===== */
ul.nav {
  list-style: none;
  margin: 0;
  padding: 0;
  background: #333;
  overflow: hidden;
}

ul.nav li { float: left; }

ul.nav li a {
  color: white;
  padding: 14px 16px;
  display: block;
  text-decoration: none;
}

ul.nav li a:hover { background: #111; }

.fixed {
  position: fixed;
  top: 0;
  width: 100%;
}

.sticky {
  position: sticky;
  top: 0;
}

.gallery {
  display: flex;
  flex-wrap: wrap;
}

.gallery div {
  width: 25%;
  padding: 5px;
}

.gallery img {
  width: 100%;
}

@media(max-width:768px) {
  .gallery div { width: 50%; }
}

@media(max-width:480px) {
  .gallery div { width: 100%; }
}

.form {
  max-width: 500px;
  padding: 20px;
  border: 2px solid green;
}

</style>

